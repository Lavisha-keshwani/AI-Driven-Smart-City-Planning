# ─── SmartCityAI configuration ────────────────────────────────────────────────
# Copy to .env and fill in. Never commit .env — it is in .gitignore.
# Every path below has a repository-relative default, so a fresh clone with the
# models/ directory in place needs only GROQ_API_KEY.

# ─── Groq LLM (required for agent narratives) ────────────────────────────────
# Free key: https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Optional second model, tried if the primary fails. Leave blank to disable.
GROQ_FALLBACK_MODEL=
LLM_TEMPERATURE=0.3
LLM_TIMEOUT=60
# Set false to run entirely without the LLM. Agents then emit deterministic
# summaries and label them source="deterministic_fallback".
LLM_ENABLED=true

# ─── Model artifacts ─────────────────────────────────────────────────────────
# Defaults resolve under <repo>/models. Override only if stored elsewhere.
# MODELS_ROOT=
# SURFACE_WATER_MODEL_PATH=
# URBAN_MODEL_PATH=
# FLOOD_MODEL_PATH=
# MICROPLASTIC_MODEL_PATH=

# Per-model roots, if the bundles were unpacked to custom locations:
# MODEL1_ROOT=
# MODEL2_ROOT=
# MODEL3_ROOT=
# MODEL4_ROOT=

# Which algorithm's artifact and tuned threshold to serve. Must match a key in
# the model's thresholds.json.
MODEL1_ALGORITHM=xgboost
MODEL3_ALGORITHM=random_forest

# ─── Feature datasets ────────────────────────────────────────────────────────
# DATA_ROOT=
# MODEL1_DATASET=
# MODEL3_DATASET=
# GRID_METADATA_CSV=
# GHSL_DIR=
# OPEN_BUILDINGS_DIR=
# SRTM_CSV=
# CHIRPS_DIR=
# SURFACE_WATER_LAYER_CSV=

# ─── Model 2 forward validation ──────────────────────────────────────────────
# Historical epoch (features) and later epoch (growth target).
MODEL2_T0_YEAR=2000
MODEL2_T1_YEAR=2020
MODEL2_RAINFALL_YEAR=2020

# ─── Spatial framework ───────────────────────────────────────────────────────
GRID_CELL_SIZE_M=1000
GRID_CRS=EPSG:4326

# ─── Classification thresholds ───────────────────────────────────────────────
# Flood-risk bands, applied over the tuned operating threshold (0.572).
FLOOD_RISK_MODERATE_THRESHOLD=0.30
FLOOD_RISK_HIGH_THRESHOLD=0.60

# Urban suitability labelling. false = argmax of class probabilities, the rule the
# model was validated under. true = use the score thresholds below instead.
URBAN_CLASS_FROM_SCORE=false
URBAN_SCORE_GREEN_THRESHOLD=0.66
URBAN_SCORE_YELLOW_THRESHOLD=0.33

# Global Surface Water occurrence that defined the Model 1 target.
WATER_OCCURRENCE_THRESHOLD_PCT=25

# ─── NASA POWER (no API key required) ────────────────────────────────────────
NASA_POWER_TIMEOUT=30
NASA_POWER_CACHE_SIZE=256
# NASA_POWER_DAILY_URL=
# NASA_POWER_CLIMATOLOGY_URL=

# ─── Server ──────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
LOG_LEVEL=INFO
MAX_UPLOAD_BYTES=10485760
