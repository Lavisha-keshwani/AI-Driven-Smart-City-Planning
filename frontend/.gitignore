# Frontend-specific ignores. The root .gitignore covers the common cases.

node_modules/
dist/
dist-ssr/
.vite/

# Vite local env overrides, e.g. VITE_API_BASE_URL
.env.local
.env.*.local

# Browser smoke-test output
e2e/screenshots/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

*.local
.eslintcache
