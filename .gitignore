# ─── Secrets ─────────────────────────────────────────────────────────────────
# Never commit real credentials. Use .env.example as the template.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
credentials.json
service-account*.json

# ─── Large model and data artifacts ──────────────────────────────────────────
# The trained artifacts and their feature tables total ~6.5 GB, so they are
# distributed alongside the repository rather than committed. README.md documents
# the expected layout, and GET /api/models/status verifies it at runtime.
#
# Written as "models/*" rather than "models/" so Git still descends into the
# directory and can re-include its .gitignore, which keeps the folder present on
# a fresh clone.
models/*
!models/.gitignore

# ─── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
